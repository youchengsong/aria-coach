 "lyrics": [
  {
   "text": "Amarilli, mia bella,",
   "zh": "阿玛丽莉，我的美人，"
  },
  {
   "text": "non credi, o del mio cor dolce desio,",
   "zh": "你不相信吗，噢我心中甜蜜的渴望，"
  },
  {
   "text": "d'esser tu l'amor mio?",
   "zh": "你就是我的爱？"
  },
  {
   "text": "Credilo pur: e se timor t'assale,",
   "zh": "请相信吧：如果恐惧袭来，"
  },
  {
   "text": "dubitar non ti vale.",
   "zh": "怀疑对你没有用。"
  },
  {
   "text": "Aprimi il petto e vedrai scritto in core:",
   "zh": "打开我的胸膛，你将看到刻在心上的："
  },
  {
   "text": "Amarilli, Amarilli, Amarilli è il mio amore.",
   "zh": "阿玛丽莉，阿玛丽莉，阿玛丽莉是我的爱。"
  }
 ],
 "story": {
  "background": "朱利奥·卡奇尼是巴洛克早期「新音乐」（Le nuove musiche）运动的先驱之一。这首《阿玛丽莉》发表于 1602 年的同名歌曲集中，是独唱配通奏低音的开创性作品。经 Parisotti 编入声乐教学集后，它成为所有声部学生接触巴洛克意大利声乐的第一首作品。",
  "situation": "牧人向名叫阿玛丽莉的女子表白：你不相信自己是我的爱吗？请相信，不要怀疑。打开我的胸膛，你会看到你的名字刻在我心上。这是一种激情而真诚的告白——不是恳求，而是确信。",
  "relationships": "歌者与阿玛丽莉之间：歌者深爱她，她似乎不信。歌者不是在哀叹，而是在证明——他愿意打开胸膛来展示真心。",
  "intent": "开头平静而坚定地说出她的名字，然后语气逐渐加强。'Credilo pur'是转折——从描述转为劝说。'Aprimi il petto'是全曲最戏剧性的一句——想象真的要撕开胸膛。结尾三次呼唤'Amarilli'要逐渐放大又收回，像余音回荡。",
  "plain30": "一个牧人对心上人说：你不信我爱你？那就打开我的胸膛看——你的名字刻在我心上。阿玛丽莉，阿玛丽莉，你就是我的爱。这是巴洛克时代最早的独唱歌曲之一。",
  "arc": "g 小调，4/4。旋律以 D4 反复音开始，沉稳而内敛。中段向上发展，'dubitar non ti vale'到达一个半终止。'Aprimi il petto'旋律上行跳进，是戏剧高潮。结尾三次'Amarilli'使用下行音阶回归主音。情绪：平静告白—劝说—激情证明—余音。",
  "motif": "核心动机是开头的反复音——同音级反复代表坚定。它在'non credi'处以同样的反复音形态延续。'Aprimi il petto'打破反复音，用跳进表达激情。结尾三次'Amarilli'的下行级进是全曲最美的旋律线，每次重复都更深沉。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "'Amarilli, mia bella'反复音动机——坚定的告白"
   },
   {
    "phrase": 4,
    "note": "'Credilo pur'转折——从描述到劝说"
   },
   {
    "phrase": 6,
    "note": "'Aprimi il petto'跳进——全曲戏剧高潮"
   },
   {
    "phrase": 7,
    "note": "三次'Amarilli'下行级进——余音回荡的结束"
   }
  ],
  "technique": "这是练习巴洛克声乐风格的入门曲。反复音不能唱得机械——每个音都有微小的力度变化。长乐句需要稳定的气息支撑。'Aprimi il petto'的跳进不要用力推，让气息自然带上去。结尾的三次'Amarilli'音量逐渐减弱，最后一次几乎是耳语。",
  "classroom": [
   "先读中文，理解这是一个确信自己被爱的人在说话——不是悲伤，是热情。",
   "慢速朗读意大利语，注意双辅音 ll、tt 的停顿。",
   "练习反复音：同一个音唱四次，每次力度略有不同。",
   "按节拍说词，♩=66，感受 4/4 的稳定脉动。",
   "听旋律参考，注意开头反复音与中间跳进的对比。",
   "把歌词放回旋律，先练前三句的平静，再练'Aprimi il petto'的激情。",
   "完整演唱。结尾三次'Amarilli'的渐弱是全曲的灵魂——让声音像烛光一样慢慢消失。"
  ]
 },
 "hints": [
  {
   "title": "双辅音",
   "items": [
    "Amarilli：双 l，舌尖抵上齿龈停留",
    "bella：双 l",
    "petto：双 t，清晰爆破",
    "scritto：双 t"
   ]
  },
  {
   "title": "元音与连读",
   "items": [
    "mia 是双元音 [mi-a]，不要读成 [mja]",
    "desio = desiderio 的诗体缩写，重音在 si：de-SÌ-o",
    "d'esser = di essere 的省音",
    "timor t'assale：r-t 连读，不要断开"
   ]
  },
  {
   "title": "开闭口元音",
   "items": [
    "bella 的 e 是开口 [ɛ]",
    "core 的 o 是开口 [ɔ]",
    "amore 的 o 是开口 [ɔ]，e 是闭口 [e]"
   ]
  }
 ],
