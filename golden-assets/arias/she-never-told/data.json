 "lyrics": [
  {
   "text": "She never told her love,",
   "zh": "她从未说出她的爱，"
  },
  {
   "text": "but let concealment, like a worm in the bud, feed on her damask cheek.",
   "zh": "只让隐忍像蓓蕾里的蛀虫，啃食她绯红的脸颊。"
  },
  {
   "text": "She sat, like Patience on a monument, smiling at grief.",
   "zh": "她坐着，像纪念碑上的“忍耐”雕像，对悲伤微笑。"
  }
 ],
 "story": {
  "background": "海顿 1795 年第二次访问伦敦期间创作了第二集《英语坎佐内塔》，歌词选用莎士比亚《第十二夜》中薇奥拉的台词。4/4 Largo assai，长达十余小节的钢琴前奏几乎是一首独立的慢板，声乐部分只有三句，是海顿最深沉的英语歌曲。",
  "situation": "女扮男装的薇奥拉暗恋公爵奥西诺，却要替他向奥丽维亚传情。公爵问她是否有过恋爱，她只能说“我父亲有一个女儿爱上了一个男人”——然后讲这个“姐姐”如何把爱藏在心里，像蓓蕾里的蛀虫，坐在那里对悲伤微笑。她说的是自己。",
  "relationships": "薇奥拉（歌者，化名切萨里奥）与公爵奥西诺（听众，不知道她是女人）。歌曲是隐藏身份下的自白：她描述“她”，公爵听到的是一个故事，观众听到的是告白。",
  "intent": "开口要极静、极慢，像不敢说出口；“but let concealment” 略带痛感，“feed on her damask cheek” 声音变暗。“She sat, like Patience” 转为一种平静的尊严；“smiling at grief” 反复时，第一次微笑、第二次悲伤，最后收成最弱的长音。全曲不能用力——它的力量在克制。",
  "plain30": "一个女扮男装的女孩暗恋着主人，却只能说“我有个姐姐也这样爱过一个人”，然后描述那份藏在心里的爱如何把她啃食。她在讲自己。",
  "arc": "4/4 Largo assai。长钢琴前奏在小调与大调间徘徊；声乐进入后旋律以宽广的级进和长音构成，“concealment” 处出现半音下行，“feed on her damask cheek” 音区下沉；“She sat, like Patience” 回到大调、音区抬高，“smiling at grief” 两次反复以长音结束。情绪：隐忍—痛—尊严—平静的悲伤。",
  "motif": "核心动机是 “She ne-ver told” 的长音加半音下行：说不出口的叹息。它在 “concealment” 处以半音进行再现，在 “smiling at grief” 处拉长为全曲最长的音。演唱时半音要唱准、唱轻，不要滑。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "第 1 句 “She never told her love” 长音加半音下行动机首次出现。"
   },
   {
    "phrase": 2,
    "note": "第 2 句 “but let concealment” 动机以半音进行再现，痛感。"
   },
   {
    "phrase": 3,
    "note": "第 3 句 “She sat, like Patience” 动机转大调抬高，尊严。"
   },
   {
    "phrase": 3,
    "note": "第 3 句末 “smiling at grief” 动机拉长为最长音，反复两次。"
   }
  ],
  "technique": "呼吸：极慢速，长音多，每句前吸足并保持均匀气流。咬字：英语词尾辅音（told、bud、cheek、sat）收清；th 清晰。换声区：女高音在 E5–F5（“damask”“Patience”）经过换声区，保持轻。高音：最高音 F5 在 “Patience” 或 “grief”，是克制的抬头，不是爆发；长音上不要加力。",
  "classroom": [
   "先读中文，弄清“她”其实是“我”。",
   "慢速读英语，标出重读音节。",
   "分离元音：练长元音 [iː]、[ɜː] 的稳定。",
   "按 4/4 极慢速说词，体会长音。",
   "听单音旋律，注意半音下行。",
   "把歌词放回旋律，先练第一句的长音，再练反复。",
   "用正常速度完整演唱，全曲不超过中等音量。"
  ]
 },
 "hints": [
  {
   "title": "重读与弱读",
   "items": [
    "she NEV-er TOLD her LOVE——told 与 love 重读；con-CEAL-ment 重音在第二音节；DAM-ask、MON-u-ment、PA-tience。",
    "“like a worm in the bud” 中 a、in、the 弱读。"
   ]
  },
  {
   "title": "舞台英语",
   "items": [
    "英式舞台发音：her [hɜː]、worm [wɜːm] 词尾 r 不卷；grief [ɡriːf] 长元音。",
    "“damask” 读 [ˈdæməsk]；“Patience” [ˈpeɪʃəns]。"
   ]
  },
  {
   "title": "元音与长音",
   "items": [
    "love [ʌ]、bud [ʌ]、cheek [iː]、sat [æ]、smiling [aɪ]。",
    "“grief” 的长音在旋律上反复延长，保持 [iː] 不变形。"
   ]
  }
