 "lyrics": [
  {
   "text": "Vaga luna, che inargenti queste rive e questi fiori",
   "zh": "美丽的月亮，你银光洒满了河岸和花朵，"
  },
  {
   "text": "ed inspiri agli elementi il linguaggio dell'amor,",
   "zh": "你将爱的语言注入万物之中，"
  },
  {
   "text": "testimonio or sei tu sola del mio fervido desir,",
   "zh": "如今只有你见证了我炽热的渴望，"
  },
  {
   "text": "ed a lei che m'innamora conta i palpiti e i sospir.",
   "zh": "请你向她诉说我的心跳和叹息。"
  },
  {
   "text": "Dille pur che lontananza il mio duol non può lenir,",
   "zh": "告诉她，距离无法减轻我的痛苦，"
  },
  {
   "text": "che se nutro una speranza, ella è sol nell'avvenir.",
   "zh": "如果我还怀有一丝希望，那只在未来之中。"
  }
 ],
 "story": {
  "background": "贝利尼（1801-1835）是 19 世纪意大利美声歌剧的代表人物，以《诺尔玛》《梦游女》《清教徒》闻名。《Vaga luna》是他的室内声乐作品「三首咏叹调」之一（约 1838 年出版），虽然不是歌剧选段，但完美体现了贝利尼标志性的悠长旋律线条（'la melodia lunga'）和纯净的美声风格。这首作品常被用作美声入门教学的第一首意大利歌曲。",
  "situation": "一个月夜。歌者独自站在河边，仰望银色的月光洒在花朵和水面上。他（她）向月亮倾诉对远方爱人的思念，请求月亮做信使，把自己的心跳和叹息传达给她。这不是戏剧性的场景，而是一幅安静的、带有些许忧伤的抒情画。",
  "relationships": "歌者与月亮：月亮是唯一的听众和见证者（testimonio）。歌者与爱人：爱人不在身边，歌者只能通过月亮传话。整首歌是一封写给月亮的情书，请它代为转达。",
  "intent": "从宁静的景物描写开始——月光、河岸、花朵——逐渐过渡到个人告白。第一段是向月亮倾诉，第二段是请月亮传话。演唱时应保持 bel canto 的纯净和流畅，不要过度表情化——这首歌的美在于旋律本身的优雅，而不是戏剧冲突。",
  "plain30": "一个人在月夜向月亮倾诉：请你把我的心跳和叹息告诉她，告诉她距离无法减轻我的思念，我的希望只在未来。",
  "arc": "降A大调，行板（Andantino），3/4 拍。旋律以级进为主，偶尔小跳——典型的贝利尼风格：看似简单却要求完美的连贯。第一段（A 段）在中低音域叙述，第二段（B 段）攀升到高音域（Ab5）抒发热情，然后回归到平静的 A 段结束。整体情绪从宁静到温暖再到宁静。",
  "motif": "核心旋律是从 Ab4 级进上行到 Bb4-C5 再回落的弧形——像月光缓缓升起又落下。这个「拱形旋律」在每一句中都重复出现，只是每次攀升的高度不同：第一段只到 Eb5，B 段飞到 Ab5 再 F5，是全曲的情感顶点。",
  "technique": "这是练习 legato（连贯歌唱）的绝佳曲目。每个乐句都要像一条不断的丝线——音与音之间不能有缝隙。3/4 拍要有自然的强弱：第一拍稍重，二三拍轻。注意呼吸位置：在逗号和句号处换气，不要在词的中间断开。B 段的高音 Ab5 要用头声，不要推。",
  "motifPositions": [
   {
    "phrase": "1",
    "note": "开头拱形旋律：Ab4→Bb4→C5→Bb4→Ab4，月光缓缓升起"
   },
   {
    "phrase": "5",
    "note": "B 段开始：Eb5 平台，旋律进入高音域，情感升温"
   },
   {
    "phrase": "6",
    "note": "全曲高潮：Ab5 出现在「miei」，然后 F5-Eb5 下行，是最热烈的一刻"
   },
   {
    "phrase": "8",
    "note": "结尾回归：旋律回到中音域，归于宁静"
   }
  ],
  "classroom": [
   "先读中文翻译：理解这是一封通过月亮传递的情书——不是激烈的表白，而是温柔的倾诉。",
   "慢速朗读意大利语：注意每个元音的纯净——a 就是 [a]，不是 [æ]；o 是圆的 [ɔ]；u 是 [u]。",
   "分离元音练习：Va-ga lu-na che in-ar-gen-ti，每个音节都要清晰。",
   "用节拍器在 ♩=50 的速度下按节拍说词，感受 3/4 的摇曳感。",
   "听合成旋律参考：注意拱形旋律的上行和回落，像呼吸一样自然。",
   "把歌词放回旋律，先慢速唱。最重要的是 legato——每个音都连着下一个音。",
   "以正常速度演唱。想象你站在月光下的河边，对月亮轻声说话——不需要大声，只需要美。"
  ]
 },
 "hints": [
  {
   "title": "意大利语元音",
   "items": [
    "意大利语有 7 个元音：a, è (开口 e), é (闭口 e), i, ò (开口 o), ó (闭口 o), u",
    "'luna' 的 'u' 是纯圆唇元音 [u]，不要滑向 [ju]",
    "'fiori' 的 'io' 是双元音 [jo]，快速滑过",
    "'cuore/amore' 的 'o' 是开口 [ɔ]，嘴巴要张圆"
   ]
  },
  {
   "title": "双辅音",
   "items": [
    "'inargenti' 的 'nn' 不是真正的双辅音（in-ar-gen-ti），但注意清晰的音节分隔",
    "'palpiti' 的 'lp' 要干净地切分：pal-pi-ti",
    "'sospiri' 的 's' 在元音间浊化为 [z]：so-spi-ri"
   ]
  },
  {
   "title": "连读与气息",
   "items": [
    "'che inargenti' 中 'che' 和 'in' 之间轻微连读",
    "'dell'amor' 是省略形式：dello amore → dell'amor，元音连接要流畅",
    "3/4 拍的摇曳感是这首歌的核心——像月光下的水波，不要唱得太方正"
   ]
  }
 ],
