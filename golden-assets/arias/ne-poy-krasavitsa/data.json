 "lyrics": [
  {
   "text": "Не пой, красавица, при мне",
   "zh": "不要唱了，美人，在我面前"
  },
  {
   "text": "Ты песен Грузии печальной;",
   "zh": "不要唱那格鲁吉亚的忧伤歌曲；"
  },
  {
   "text": "Напоминают мне оне",
   "zh": "它们让我想起"
  },
  {
   "text": "Другую жизнь и берег дальний.",
   "zh": "另一种生活和遥远的海岸。"
  },
  {
   "text": "Увы! Напоминают мне",
   "zh": "唉！它们让我想起"
  },
  {
   "text": "Твои жестокие напевы",
   "zh": "你那残忍的歌声"
  },
  {
   "text": "И степь, и ночь, и при луне",
   "zh": "和草原、和夜晚、和月光下"
  },
  {
   "text": "Черты далёкой, бедной девы.",
   "zh": "那遥远的、可怜的少女的面容。"
  },
  {
   "text": "Я призрак милый, роковой,",
   "zh": "那可爱而致命的幻影，"
  },
  {
   "text": "Тебя увидев, забываю;",
   "zh": "看到你时，我便忘却；"
  },
  {
   "text": "Но ты поёшь — и предо мной",
   "zh": "但你一唱——在我面前"
  },
  {
   "text": "Его я вновь воображаю.",
   "zh": "它又重新浮现。"
  },
  {
   "text": "Не пой, красавица, при мне",
   "zh": "不要唱了，美人，在我面前"
  },
  {
   "text": "Ты песен Грузии печальной;",
   "zh": "不要唱那格鲁吉亚的忧伤歌曲；"
  },
  {
   "text": "Напоминают мне оне",
   "zh": "它们让我想起"
  },
  {
   "text": "Другую жизнь и берег дальний.",
   "zh": "另一种生活和遥远的海岸。"
  }
 ],
 "story": {
  "background": "这首浪漫曲是 20 岁的拉赫玛尼诺夫在 1893 年创作的 Op.4 六首浪漫曲之一，歌词选自普希金 1828 年的诗作。普希金原诗写给一位在沙龙中演唱格鲁吉亚歌曲的女子——这些歌曲唤起了诗人在高加索的记忆和对一位远方女子的思念。拉赫玛尼诺夫的谱曲赋予了诗歌一种东方色彩的忧郁旋律，钢琴伴奏中隐含着格鲁吉亚音阶的特征音程。",
  "situation": "一个沙龙或私人聚会的场景。一位美丽的女子正在唱格鲁吉亚歌曲。叙述者请求她停下来——不是因为不好听，而是因为这些旋律让他想起了遥远高加索的月夜和一位他无法忘怀的女子。",
  "relationships": "叙述者面对两个女性形象：眼前的'美人'（красавица）正在唱歌，和记忆中'遥远的、可怜的少女'（далёкая, бедная дева）。他在理性上想忘记过去，但每当格鲁吉亚的旋律响起，过去的幻影就会重新浮现。这是一首关于记忆的无力抗拒的歌。",
  "intent": "演唱应从温柔的恳求开始——'不要唱了'不是命令，而是请求。中段（'唉！它们让我想起'）情感加深，声音变得更沉郁。'我看到你时便忘却；但你一唱——它又浮现'是全曲最戏剧性的转折。最后的再现部回到恳求，但语气中多了一层无奈的接受。",
  "plain30": "一个男人请求面前的美人不要再唱格鲁吉亚歌曲了——这些旋律让他想起了高加索的月夜和一位他无法忘怀的远方少女。他越想忘记，歌声越让记忆清晰。",
  "arc": "升c小调，中庸的行板。开头的旋律低沉温和，像一声轻轻的恳求。'напоминают мне оне' 处钢琴出现东方色彩的半音进行，暗示格鲁吉亚的旋律。中段'Увы!'标志着情感爆发，调性短暂偏向大调（A大调/E大调），仿佛阳光穿透云层——但随即回到小调。'Я призрак милый' 处旋律最为激动，声部攀升到高音区。结尾的再现（'Не пой'）钢琴尾奏渐弱消失，像记忆慢慢沉入黑暗。",
  "motif": "下行半音的'叹息'动机贯穿全曲——每次出现'напоминают'（让我想起）时，旋律都会出现半音下行。钢琴伴奏中的增二度音程（如升F到升G#）模仿格鲁吉亚音阶的异域色彩。声乐线在'Но ты поёшь'（但你一唱）处突然上行跳进，是回忆突然涌来的画面。",
  "technique": "这首歌要求在低音区保持温暖的共鸣——开头的'Не пой'在C#4附近，需要充分的胸腔支撑而不是压喉。中段的情感爆发不要过于激烈，拉赫玛尼诺夫的浪漫曲风格偏向内敛的热情而非歌剧式的宣泄。注意钢琴间奏段（m14–m18, m20–m21）的东方色彩旋律——演唱者在这些段落中的静默也是表演的一部分。",
  "motifPositions": [
