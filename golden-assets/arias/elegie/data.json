 "lyrics": [
  {
   "text": "Ô doux printemps d’autrefois, vertes saisons,",
   "zh": "从前温柔的春天啊，青翠的季节，"
  },
  {
   "text": "vous avez fui pour toujours!",
   "zh": "你们已经永远离去！"
  },
  {
   "text": "Je ne vois plus le ciel bleu,",
   "zh": "我再看不见蓝天，"
  },
  {
   "text": "je n’entends plus les chants joyeux des oiseaux!",
   "zh": "再听不见鸟儿欢快的歌唱！"
  },
  {
   "text": "En emportant mon bonheur, ô bien-aimé, tu t’en es allé!",
   "zh": "你带走了我的幸福，心爱的人，你走了！"
  },
  {
   "text": "Et c’est en vain que revient le printemps!",
   "zh": "春天回来也是徒然！"
  },
  {
   "text": "Oui, sans retour, avec toi, le gai soleil, les jours riants sont partis!",
   "zh": "是的，一去不返——明亮的太阳、欢笑的日子都随你而去！"
  },
  {
   "text": "Comme en mon cœur tout est sombre et glacé!",
   "zh": "我心中的一切都多么阴暗冰冷！"
  },
  {
   "text": "Tout est flétri! Pour toujours!",
   "zh": "一切都凋零了！永远！"
  }
 ],
 "story": {
  "background": "《悲歌》原是马斯内为勒孔特·德·利尔的悲剧《复仇女神》（1873）所写配乐中的一段大提琴旋律，1875 年由路易·加莱配上歌词，成为 19 世纪末最流行的法语沙龙歌曲之一，几乎所有著名歌唱家都录过它。e 小调，4/4 Lent。",
  "situation": "春天回来了，但叙述者的爱人已经离开（可能是死亡，也可能是离别）。他看着蓝天、听着鸟鸣，却什么都感觉不到——一切随那个人一起走了。他想要的是过去的春天，害怕的是余生都是冬天。",
  "relationships": "只有“我”和已离去的“心爱的人”（bien-aimé，阳性形式，说明被呼唤者是男性）。歌曲在第二人称呼唤与自言自语间切换，是一段没有听众的哀悼。",
  "intent": "开口要轻、暗、慢，像对自己说话；“vous avez fui pour toujours” 略微用力，是第一次承认失去。“En emportant mon bonheur” 起情绪上升，“tu t’en es allé” 是全曲最痛的一句，可放宽音量；随后 “Comme en mon cœur” 回到低语，“Pour toujours” 用最弱的声音收束。",
  "plain30": "春天又来了，可他心爱的人已经走了。他说：天空、鸟鸣、阳光都随你而去，我心里只剩冰冷。三分钟的歌，只讲一件事——失去之后，季节不再有意义。",
  "arc": "e 小调，4/4 Lent。旋律以下行级进为主，每句像一声叹息落下；钢琴用低音持续的八分音符模拟大提琴原曲。开头两句在低音区低语，“Je ne vois plus” 起音区抬高，“tu t’en es allé” 到达最高音 F5（男中音 F4 处对应），随后一路下行到 “Pour toujours” 的主音。情绪：麻木—承认—痛苦—死寂。",
  "motif": "核心动机是下行叹息音型：“Ô doux prin-temps” 从属音落到主音，像叹气。它在每句开头以相同轮廓出现，在 “tu t’en es allé” 被放大为从最高音的下行，尾句 “Pour toujours” 压缩为最短的两个音。演唱时下行的第二个音永远比第一个轻。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "第 1 句 “Ô doux printemps” 下行叹息音型首次出现。"
   },
   {
    "phrase": 4,
    "note": "第 4 句 “je n’entends plus” 动机音区抬高，情绪开始外露。"
   },
   {
    "phrase": 5,
    "note": "第 5 句 “tu t’en es allé” 从最高音大幅下行，全曲最痛处。"
   },
   {
    "phrase": 9,
    "note": "第 9 句 “Pour toujours” 动机压缩为两个音，以最弱音结束。"
   }
  ],
  "technique": "呼吸：速度极慢，每句两小节仍要一口气，吸气深而无声。咬字：法语词尾辅音多数不发，但 “flétri”“glacé” 的元音要清晰；鼻化元音在长音上保持。换声区：男中音在 D4–E4（“ciel bleu”“bonheur”）进入换声区，保持元音圆、声音不撑。高音：最高音在 “allé”，是情绪爆发，靠气流而不是喉部用力，随后立即收回。",
  "classroom": [
   "先读中文，找出“过去—现在—永远”三个时间词。",
   "慢速读法语，标出鼻化元音和不发音的词尾辅音。",
   "分离元音：练 eu/œu/ou 三个圆唇元音的区别。",
   "按 4/4 慢拍说词，每拍一个音节以内。",
   "听单音旋律，感受每句的下行叹息。",
   "把歌词放回旋律，先练开头的低语，再练中段的爆发。",
   "用正常速度完整演唱，最后一句用最弱的声音。"
  ]
 },
 "hints": [
  {
   "title": "鼻化元音",
   "items": [
    "printemps 含 in [ɛ̃] 与 en [ɑ̃]；saisons、chants、emportant 的 on/an 要在长音上保持鼻化。",
    "“bien-aimé” 的 ien [jɛ̃] 与后面的 aimé 联诵 [bjɛ̃nɛme]。"
   ]
  },
  {
   "title": "联诵与省音",
   "items": [
    "“vous‿avez” [vuzave]、“les‿chants”不联诵（s 后为辅音）、“des‿oiseaux” [dezwazo]、“tout‿est” [tutɛ]。",
    "“d’autrefois”“n’entends”“t’en es allé”“c’est” 均为省音。"
   ]
  },
  {
   "title": "词尾辅音",
   "items": [
    "printemps、toujours、oiseaux、glacé 的词尾辅音不发（toujours 的 s 不发）；flétri 的 i 清亮。",
    "bleu 的 eu [ø] 圆唇；cœur 的 œu [œ] 更开。"
   ]
  }
 ],
