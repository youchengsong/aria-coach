 "lyrics": [
  {
   "text": "Pur dicesti, o bocca bella,",
   "zh": "美丽的嘴唇，你曾说过，"
  },
  {
   "text": "quel soave e caro si,",
   "zh": "那甜蜜而珍贵的一声'好'，"
  },
  {
   "text": "che fa tutto il mio piacer.",
   "zh": "那是我全部的快乐。"
  },
  {
   "text": "Per onor di sua facella",
   "zh": "为了他的火炬的荣耀，"
  },
  {
   "text": "con un bacio Amor t'apri,",
   "zh": "爱神用一个吻打开了你，"
  },
  {
   "text": "dolce fonte del goder.",
   "zh": "甜蜜的快乐之泉。"
  }
 ],
 "story": {
  "background": "安东尼奥·洛蒂是威尼斯圣马可大教堂的管风琴师和合唱指挥。这首小咏叹调以其优雅的旋律和甜蜜的情感成为男高音入门教学的标准曲目。",
  "situation": "歌者回味恋人曾经说的那一声'si'（好）——那是最甜蜜的时刻。爱神用一个吻打开了那美丽的嘴唇。这是一首充满喜悦的回忆之歌。",
  "relationships": "歌者是一位恋人，回忆着美人嘴唇曾说的那个温柔的「是」。这首歌表达了对爱的回忆和甜蜜。Lotti 的旋律以典雅和简洁著称，是意大利声乐教学的经典入门曲目。",
  "intent": "全曲充满喜悦和轻快。'bocca bella'要唱得甜蜜。'quel soave e caro si'的'si'是全曲的关键词——要特别温柔地处理。'Amor t'apri'带着一点调皮的得意。",
  "plain30": "你曾对我说'好'——那一声甜蜜的'好'是我全部的快乐。爱神用一个吻打开了你美丽的嘴唇。这是一首关于被爱的喜悦的轻快小歌。",
  "arc": "F 大调，4/4 Allegretto grazioso。旋律以 C5 开始下行，轻盈活泼。中段稍有色彩变化但始终明亮。结尾回到 F 大调的主音，以满足的语气结束。",
  "motif": "核心动机是'Pur dicesti'的下行音阶——像在甜蜜地叙述。'caro si'处的长音是全曲的情感中心。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "'Pur dicesti, o bocca bella'——甜蜜叙述的下行音阶"
   },
   {
    "phrase": 2,
    "note": "'caro si'——情感中心，温柔的长音"
   },
   {
    "phrase": "3",
    "note": "'con un bacio Amor t'apri'——调皮的爱神意象"
   }
  ],
  "technique": "保持轻快和优雅——不要太重。下行音阶要均匀流畅。'si'的长音需要稳定的气息但不需要大音量。适合练习在中高音区的轻声控制。",
  "classroom": [
   "先读中文——这是一首关于甜蜜回忆的快乐歌。",
   "慢速朗读意大利语，感受每个词的甜蜜。",
   "练习下行音阶的流畅。",
   "按节拍说词，♩=80，轻快的 Allegretto。",
   "听旋律参考。",
   "放入歌词，保持笑意在声音里。",
   "完整演唱。想象你在回味世界上最甜蜜的一个'好'字。"
  ]
 },
