 "lyrics": [
  {
   "text": "Ещё в полях белеет снег,",
   "zh": "田野上仍然白雪皑皑，"
  },
  {
   "text": "А воды уж весной шумят —",
   "zh": "但春天的水流已经喧响——"
  },
  {
   "text": "Бегут и будят сонный брег,",
   "zh": "奔涌着唤醒沉睡的河岸，"
  },
  {
   "text": "Бегут и блещут, и гласят...",
   "zh": "奔涌着闪耀，高声宣告……"
  },
  {
   "text": "Они гласят во все концы:",
   "zh": "它们向四面八方宣告："
  },
  {
   "text": "Весна идёт, весна идёт!",
   "zh": "春天来了，春天来了！"
  },
  {
   "text": "Мы молодой весны гонцы,",
   "zh": "我们是青春之春的信使，"
  },
  {
   "text": "Она нас выслала вперёд!",
   "zh": "是她派我们先行出发！"
  },
  {
   "text": "Весна идёт! Весна идёт!",
   "zh": "春天来了！春天来了！"
  },
  {
   "text": "И тихих, тёплых, майских дней",
   "zh": "那宁静、温暖的五月时光"
  },
  {
   "text": "Румяный, светлый хоровод",
   "zh": "红润而明亮的圆舞"
  },
  {
   "text": "Толпится весело за ней.",
   "zh": "欢快地簇拥在她身后。"
  }
 ],
 "story": {
  "background": "《春潮》是拉赫玛尼诺夫 1896 年创作的 Op.14 十二首浪漫曲的终曲，也是他最著名的浪漫曲之一。歌词选自费奥多尔·丘特切夫（1803–1873）的同名诗作，描写冬末春初冰雪消融、溪流奔涌的景象。丘特切夫是俄国最重要的抒情诗人之一，以简练而有力的自然意象著称。拉赫玛尼诺夫的谱曲将诗歌的生命力转化为滚滚奔腾的钢琴音流和高亢激昂的声乐线。",
  "situation": "初春的旷野。田野上的积雪尚未完全融化，但溪流已经开始奔涌——它们是春天的先锋，向四方宣告冬天的结束。这不是一个具体的人物场景，而是一幅充满生命力的自然画卷。",
  "relationships": "诗中的'角色'是春水（весенние воды）本身——它们是拟人化的信使，代表春天向世界宣告自己的到来。歌者是这幅景象的见证者，也是春天能量的传导者——从第一人称观察（'田野上仍然白雪皑皑'）到直接引用春水的呼喊（'春天来了！'），歌者与自然融为一体。",
  "intent": "演唱应从一幅静态的冬景开始（'田野上白雪皑皑'），然后像解冻的河流一样迅速加速。'春天来了！'的呼喊是全曲的核心——不是优雅的宣言，而是大自然不可阻挡的力量的爆发。结尾的'欢快地簇拥在她身后'应该像洪流终于汇入大河，宽广而辉煌。",
  "plain30": "冬末春初，虽然田野上还有积雪，溪流已经奔涌起来，向四方宣告：春天来了！我们是春天的信使！这是一首关于自然复苏的生命力赞歌。",
  "arc": "降D大调，12/8 拍，Allegro vivace。钢琴从第一个小节开始就建立起奔腾的十六分音符音流——这是春水的声音，从头到尾不停歇。声乐线在开头相对平稳（描写静态的雪景），随后迅速上行（'但春水已经喧响'）。'它们向四面八方宣告'处调性偏向属方向，积蓄张力。'春天来了！'是全曲高潮——降D大调的辉煌主和弦，声部攀升到降A5甚至更高。结尾部分稍有缓和但不失光辉，在'欢快地簇拥'中以壮丽的终止收束。",
  "motif": "滚滚奔腾的十六分音符是全曲的核心动机——钢琴双手都在弹奏急速的分解和弦，模仿春水的奔涌。声乐线的上行跳进（从低音区冲向高音区）代表水流冲破冰层的力量。'Весна идёт!'的呼喊动机以纯四度或纯五度上行跳进出现，像号角一样宣告春天——这个动机在全曲中反复出现，每次都更加辉煌。",
  "technique": "这是拉赫玛尼诺夫最具技术挑战性的浪漫曲之一。声乐要求：(1) 极宽的音域——从低音区的 F3 到高音区的降A5/B5，跨度超过两个八度。(2) 在钢琴急速音流之上保持清晰的咬字——12/8 拍中每个俄语音节都要准确落在拍点上。(3) 'Весна идёт!'的反复呼喊需要充沛的气息和开放的高音——不要为了安全而收缩。(4) 结尾的长乐句需要在高音区保持强有力的支撑。建议先慢速练习钢琴与声乐的配合，再逐步提速。",
  "motifPositions": [
   {
    "phrase": "1",
    "note": "开头：'Ещё в полях белеет снег' 相对平稳的叙述，冬景"
   },
   {
    "phrase": "2",
    "note": "'А воды уж весной шумят' 旋律开始上行——春水登场"
   },
   {
    "phrase": "6",
    "note": "'Весна идёт, весна идёт!' 全曲第一个高潮——号角式呼喊"
   },
   {
    "phrase": "9",
    "note": "再现'Весна идёт!' 更加辉煌的第二次呼喊"
   },
   {
    "phrase": "11",
    "note": "'Румяный, светлый хоровод' 壮丽的终止段，音域最宽"
   }
  ],
  "classroom": [
   "先阅读中文翻译，体会诗歌的画面：白雪→溪流→呼喊→春天的队列。这是一首'自然力量'的赞歌，不是柔情的抒情。",
   "慢速朗读俄语原文。注意丘特切夫诗歌的节奏感：'Бегут и будят сонный брег, / Бегут и блещут, и гласят' —— 重复的'Бегут'（奔跑）就像水流的节拍。",
   "分离元音：'белеет' [бʲɪ-лʲе́-ɪт]（三个音节），'гласят' [гла-ся́т]。'ё' 在 'идёт' 中永远重读。",
   "按节拍说词：用节拍器在 ♩.=80 的速度下朗读（注意是复合拍），感受 12/8 拍中每组三个音节的自然分组。",
   "听合成旋律参考：感受从平稳开头到'春天来了！'呼喊的巨大能量弧线。",
   "把歌词放回旋律，先用一半速度唱。重点练习'Весна идёт!'的高音跳进——用充分的气息支撑，不要害怕音量。",
   "以正常速度完整演唱。想象自己站在春天的原野上，冰雪融化的溪流在你脚下奔涌——你是这股力量的一部分。"
  ]
 },
