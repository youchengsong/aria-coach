 "lyrics": [
  {
   "text": "L’aurora di bianco vestita già l’uscio dischiude al gran sol,",
   "zh": "身披白衣的曙光已向太阳敞开门户，"
  },
  {
   "text": "di già con le rose e sue dita carezza de’ fiori lo stuol.",
   "zh": "已用她玫瑰色的手指抚摸成群的花朵。"
  },
  {
   "text": "Commosso da un fremito arcano intorno il creato già par;",
   "zh": "四周的万物仿佛被一阵神秘的颤动打动；"
  },
  {
   "text": "e tu non ti desti, ed invano mi sto qui dolente a cantar.",
   "zh": "而你还没有醒来，我徒然在这里忧伤地歌唱。"
  },
  {
   "text": "Metti anche tu la veste bianca e schiudi l’uscio al tuo cantor!",
   "zh": "你也披上白衣，向你的歌者打开门吧！"
  },
  {
   "text": "Ove non sei la luce manca, ove tu sei nasce l’amor!",
   "zh": "你不在的地方没有光，你在的地方爱便诞生！"
  }
 ],
 "story": {
  "background": "《晨歌》是列昂卡瓦洛 1904 年专为留声机公司与男高音卡鲁索创作的歌曲，作曲家亲自钢琴伴奏录音，是最早为唱片而写的名曲之一。它继承了那不勒斯民歌式的晨间小夜曲（mattinata）传统：清晨在恋人窗下歌唱。",
  "situation": "黎明来了，万物苏醒，只有恋人还在睡。歌者站在门外，既赞美晨光，也委屈地抱怨“你还没醒，我白白在这里唱”，最后请求她穿上白衣、打开门。他想要的是被看见，害怕的是歌声无人听。",
  "relationships": "“我”（歌者）与门内沉睡的“你”。曙光（l’aurora）被拟人化为身披白衣的女子，与恋人的白衣相呼应——歌者希望恋人像曙光一样出现。",
  "intent": "第一段描写晨光，要明亮、从容，像在讲一个美景；“e tu non ti desti” 转为略带撒娇的抱怨，音色变柔。第二段 “Metti anche tu” 是请求，逐渐放宽；“ove tu sei nasce l’amor” 是全曲最高最亮处，靠前面的积累一气推上去，然后满足地收束。",
  "plain30": "天亮了，花开了，可她还在睡。歌者在门外唱：你也披上白衣、把门打开吧——你在哪里，哪里才有光。这是一首把晨光和恋人叠在一起的情歌。",
  "arc": "6/8 Allegretto，意大利式小夜曲节奏。旋律以级进与三度为主，每两小节一个波浪。第一段（描写）在中音区，“e tu non ti desti” 略降；第二段从 “Metti anche tu” 起逐句抬高，“nasce l’amor” 到达最高音 A5（原调），然后落回主音。情绪：赞美—委屈—请求—狂喜。",
  "motif": "核心动机是 6/8 上的三音级进上行：“L’au-ro-ra” 三个音一步步向上，像太阳升起。它在 “Commosso” 与 “Metti anche tu” 处以相同轮廓出现，在 “nasce l’amor” 放大为向最高音的跳进。演唱时上行的三个音要越来越亮，不要平均。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "第 1 句 “L’aurora” 三音上行动机首次出现。"
   },
   {
    "phrase": 3,
    "note": "第 3 句 “Commosso da un fremito” 动机再现，力度略增。"
   },
   {
    "phrase": 5,
    "note": "第 5 句 “Metti anche tu” 动机从更高起点再现，开始推向高潮。"
   },
   {
    "phrase": 6,
    "note": "第 6 句 “nasce l’amor” 动机放大为跳进到最高音。"
   }
  ],
  "technique": "呼吸：两小节一句，句间短促换气；结尾 “ove tu sei nasce l’amor” 需一口气。咬字：双辅音要停顿（carezza、commosso），元音饱满。换声区：男高音在 F4–G4（“dischiude”“dolente”）经过换声区，保持元音略窄、不撑。高音：A5（或按移调）在 “l’amor” 上，是全曲唯一的高音，用元音 [ɔ] 的开放共鸣，靠气息推上去，不要提前紧张。",
  "classroom": [
   "先读中文，找出“晨光”和“你”的对应关系。",
   "慢速读原文，标出重音音节和双辅音。",
   "分离元音和辅音：单独练 zz、ss、sch 三种辅音。",
   "按 6/8 说词，两个大拍，感受小夜曲的摇摆。",
   "听单音旋律，注意每句的三音上行。",
   "把歌词放回旋律，先练第一段，再练第二段的逐句抬升。",
   "用正常速度完整演唱，高音前先想好气息。"
  ]
 },
 "hints": [
  {
   "title": "重音与双辅音",
   "items": [
    "auRÒra、veSTÌta、diSCHIÙde、caRÉZza（zz 双辅音）、comMÒSso（ss）、FRÈmito——双辅音前元音短、辅音停顿。",
    "“dischiude”“schiudi” 的 sch 读 [sk]，不是 [ʃ]。"
   ]
  },
  {
   "title": "连读与省略",
   "items": [
    "“de’ fiori” 是 dei 的截略；“L’aurora”“l’uscio”“l’amor” 省音。",
    "“rose‿e sue” 在同一音上连读；“Metti anche tu” 的 -i a- 合为一音。"
   ]
  },
  {
   "title": "开闭口元音",
   "items": [
    "sol、stuol、cantor、amor 的 o 为开口 [ɔ]；“vestita” 的 e 为闭口 [e]，“desti” 的 e 为开口 [ɛ]。",
    "r 全部弹舌，“carezza”“arcano” 的 r 清晰。"
   ]
  }
 ],
