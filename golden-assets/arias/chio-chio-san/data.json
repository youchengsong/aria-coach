 "lyrics": [
  {
   "text": "Un bel dì, vedremo levarsi un fil di fumo",
   "zh": "晴朗的一天，我们会看见一缕烟升起，"
  },
  {
   "text": "sull’estremo confin del mare.",
   "zh": "在海的最远处。"
  },
  {
   "text": "E poi la nave appare.",
   "zh": "然后船出现了。"
  },
  {
   "text": "Poi la nave bianca entra nel porto, romba il suo saluto.",
   "zh": "白色的船驶进港口，鸣响它的礼炮。"
  },
  {
   "text": "Vedi? È venuto!",
   "zh": "看见了吗？他来了！"
  },
  {
   "text": "Io non gli scendo incontro. Io no.",
   "zh": "我不下去迎接他。我不去。"
  },
  {
   "text": "Mi metto là sul ciglio del colle e aspetto,",
   "zh": "我站在山坡边上等着，"
  },
  {
   "text": "e aspetto gran tempo e non mi pesa la lunga attesa.",
   "zh": "等很久，也不觉得漫长的等待有多沉重。"
  },
  {
   "text": "E uscito dalla folla cittadina un uomo, un picciol punto",
   "zh": "从城里的人群中走出一个人，一个小小的点，"
  },
  {
   "text": "s’avvia per la collina.",
   "zh": "朝山坡走来。"
  },
  {
   "text": "Chi sarà? chi sarà? E come sarà giunto che dirà? che dirà?",
   "zh": "会是谁？会是谁？他到了会说什么？说什么？"
  },
  {
   "text": "Chiamerà Butterfly dalla lontana.",
   "zh": "他会从远处喊 “蝴蝶”。"
  },
  {
   "text": "Io senza dar risposta me ne starò nascosta",
   "zh": "我不回答，藏起来，"
  },
  {
   "text": "un po’ per celia e un po’ per non morire al primo incontro,",
   "zh": "一半是逗他，一半是怕在重逢的第一刻死去，"
  },
  {
   "text": "ed egli alquanto in pena chiamerà, chiamerà:",
   "zh": "他会有点着急地喊、喊："
  },
  {
   "text": "“Piccina mogliettina, olezzo di verbena”,",
   "zh": "“小小的妻子，马鞭草的香气”，"
  },
  {
   "text": "i nomi che mi dava al suo venire.",
   "zh": "那是他从前来时给我的名字。"
  },
  {
   "text": "Tutto questo avverrà, te lo prometto.",
   "zh": "这一切都会发生，我向你保证。"
  },
  {
   "text": "Tienti la tua paura, io con sicura fede l’aspetto.",
   "zh": "你留着你的害怕吧，我怀着坚定的信念等他。"
  }
 ],
 "story": {
  "background": "《蝴蝶夫人》由普契尼作曲、伊利卡与贾科萨据约翰·路德·朗的短篇与贝拉斯科的话剧改编，1904 年在米兰斯卡拉歌剧院首演（初版失败，同年修订于布雷西亚成功）。这段咏叹调出现在第二幕开头：平克顿离开日本已三年，女仆铃木怀疑他不会回来，巧巧桑用这段 “想象中的重逢” 回答她。",
  "situation": "巧巧桑（蝴蝶）身无分文，带着平克顿不知道的孩子，仍然相信丈夫会在知更鸟筑巢的季节回来。她面对铃木的怀疑，不是争辩，而是把归来的那一天像电影一样一幕幕讲出来。她想要的是这份信念被承认，害怕的是自己也开始怀疑。",
  "relationships": "巧巧桑是长崎的前艺伎，十五岁 “嫁给” 美国海军军官平克顿；铃木是忠诚的女仆，也是唯一的听众。这段独唱把她的幻想说得越具体，观众越清楚它不会实现——它为第三幕平克顿携美国妻子归来的打击做了最残酷的铺垫。",
  "intent": "开口要像讲故事，安静、遥远、几乎是自言自语。“E poi la nave appare” 开始有了画面感，声音逐渐明亮。“Vedi? È venuto!” 是压抑不住的兴奋，但 “Io non gli scendo incontro. Io no.” 又收回来，带着少女式的骄傲。片段结尾正是这个从远景到近景的第一次转折。",
  "plain30": "一个等丈夫等了三年的年轻母亲对女仆说：总有一天，海边会升起一缕烟，白船进港，他会回来喊我的名字。她讲得越清楚，我们越知道那是一场梦。",
  "arc": "G♭大调，3/4 Andante molto calmo。开头旋律在高音区以级进缓缓下行，像从远处望向海面；节拍宽广，长音多。随着船出现，节奏收紧、音区下移，转为说话般的宣叙。片段以 “Io no” 的低语作结，为之后逐渐攀升、最终在 “l’aspetto” 上爆发的高潮蓄力。",
  "motif": "核心动机是开头 “Un bel dì, ve-dre-mo” 的五声音阶式下行：从高音开始，一步步走下，带东方色彩。它在 “sull’estremo confin del mare” 再次下行，随后 “E poi la nave appare” 用远景号角式的上行回应。演唱时高音要轻盈、聚焦，像远处的光，而不是用力推；下行的每一步保持连贯。",
  "classroom": [
   "先读中文，弄清她是在 “讲述一个想象”，而不是陈述事实。",
   "慢速读原文，注意 “vedremo”“estremo” 的重音在倒数第二音节。",
   "分离元音：练开头高音区的 u-e-i 元音，保持喉位稳定。",
   "按 3/4 慢拍说话，体会长音上的停留。",
   "听单音旋律，注意下行的每一步都是级进。",
   "把歌词放回旋律，先练 1–6 小节的长线条，再练宣叙部分。",
   "用正常速度完整演唱本片段，结尾 “Io no” 收成低语。"
  ],
  "technique": "呼吸：第 1 句是全曲最长的线条（6 小节），在 “fumo” 后短换气，“mare” 前不要断。咬字：“Un bel dì” 的 dì 重音清晰；“levarsi”“estremo” 的 s 在元音间为浊音 [z]。换声区：女高音在 E♭5–F5（“vedremo”“fumo”）处长时间停留在换声区，用头腔为主、元音略窄以保持轻盈。高音：片段最高音 G♭5 在开头 “Un bel dì” 与 “E poi la nave appare” 出现，是远景中的光，轻、稳、不推。",
  "motifPositions": [
   {
    "phrase": 1,
    "note": "第 1 句 “Un bel dì, vedremo” 五声音阶式下行动机首次出现，从最高音缓缓落下。"
   },
   {
    "phrase": 2,
    "note": "第 2 句 “E poi la nave appare” 上行回应，像远处号角。"
   },
   {
    "phrase": 3,
    "note": "第 3–4 句 “Poi la nave bianca… romba il suo saluto” 下行动机压缩为宣叙式短句。"
   },
   {
    "phrase": 6,
    "note": "第 6–7 句 “Io non gli scendo incontro. Io no.” 动机消失，以低语作片段结尾。"
   }
  ]
 },
