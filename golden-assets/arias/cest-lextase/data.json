 "lyrics": [
  {
   "text": "C'est l'extase langoureuse,",
   "zh": "这是慵懒的狂喜，"
  },
  {
   "text": "c'est la fatigue amoureuse,",
   "zh": "这是爱情的疲惫，"
  },
  {
   "text": "c'est tous les frissons des bois",
   "zh": "这是树林中所有的颤栗——"
  },
  {
   "text": "parmi l'étreinte des brises,",
   "zh": "在微风的拥抱之中，"
  },
  {
   "text": "c'est, vers les ramures grises,",
   "zh": "这是，朝着灰色的枝叶，"
  },
  {
   "text": "le chœur des petites voix.",
   "zh": "细小声音的合唱。"
  },
  {
   "text": "Ô le frêle et frais murmure!",
   "zh": "哦那纤细而清新的低语！"
  },
  {
   "text": "Cela gazouille et susurre,",
   "zh": "那啁啾与细语，"
  },
  {
   "text": "cela ressemble au cri doux",
   "zh": "像是温柔的呼喊——"
  },
  {
   "text": "que l'herbe agitée expire.",
   "zh": "被搅动的青草发出的叹息。"
  },
  {
   "text": "Tu dirais, sous l'eau qui vire,",
   "zh": "你会说，在旋转的水流下面，"
  },
  {
   "text": "le roulis sourd des cailloux.",
   "zh": "是鹅卵石沉闷的翻滚声。"
  },
  {
   "text": "Cette âme qui se lamente",
   "zh": "这个在哀叹的灵魂——"
  },
  {
   "text": "en cette plainte dormante,",
   "zh": "在这沉睡的哀诉中——"
  },
  {
   "text": "c'est la nôtre, n'est-ce pas?",
   "zh": "就是我们的，不是吗？"
  },
  {
   "text": "La mienne, dis, et la tienne,",
   "zh": "我的，你说呢，还有你的，"
  },
  {
   "text": "dont s'exhale l'humble antienne",
   "zh": "从中呼出谦卑的圣歌——"
  },
  {
   "text": "par ce tiède soir, tout bas.",
   "zh": "在这温暖的傍晚，轻轻地。"
  }
 ],
 "story": {
  "background": "《被遗忘的小咏叹调》是德布西 1887 年根据魏尔兰诗集《无言的浪漫曲》创作的六首歌曲。第一首「这是慵懒的狂喜」是整套作品的开篇——魏尔兰将爱情的余韵与自然景色融为一体：风中的颤栗、水中的卵石声、草地的叹息，都是两个灵魂合一后的回响。德布西用漂浮的和声和模糊的调性完美再现了这种恍惚状态。",
  "situation": "爱情之后的恍惚时刻——两个人躺在黄昏的自然中，分不清哪些感觉来自身体，哪些来自风和水。所有的自然声音都变成了爱情的回声。最后歌者意识到：这个在自然中哀叹的灵魂就是我们的——我的和你的。",
  "relationships": "歌者与爱人——但在这首歌中两人已经融合，「la mienne et la tienne」（我的和你的灵魂）变成了自然本身的声音。",
  "intent": "整首歌要像从梦中说话。不要有任何突然的力度变化——一切都是渐变的、流动的。开头的三个「c'est」像是在指认：这是……这是……这是……——慢慢辨认模糊感觉的名称。中段「Ô le frêle et frais murmure」是一声轻叹。结尾的「tout bas」要消失在空气中。",
  "plain30": "爱情之后的恍惚。风中的颤栗、水中的石头声、草地的叹息——所有自然的声音都变成了两个灵魂的回响。德布西用漂浮的音乐让你分不清是梦是醒。",
  "arc": "E 大调（但调性极其模糊），4/4，慢。钢琴的伴奏像水面的微波。声乐线在窄音域中飘浮，很少有大跳。三段诗对应三层感知：外部自然→声音细节→内在灵魂。和声从不真正解决——全曲维持在一种悬浮状态中。",
  "motif": "恍惚动机：声乐开头的窄幅级进——在三四个音之间摇摆，像半梦半醒。自然声动机：「le chœur des petites voix」处旋律略微展开，模仿细小声音的合唱。钢琴的分解和弦像水面的涟漪，从不形成明确的节奏重音。",
  "motifPositions": [
   {
    "phrase": "1",
    "note": "开头「C'est l'extase」——恍惚动机，窄幅飘浮"
   },
   {
    "phrase": "7",
    "note": "「Ô le frêle et frais murmure」——轻叹，声音最透明的时刻"
   },
   {
    "phrase": "13",
    "note": "「Cette âme qui se lamente」——从自然回到灵魂"
   },
   {
    "phrase": "14",
    "note": "「tout bas」——消失在温暖的空气中"
   }
  ],
  "technique": "音域不宽但对音准要求极高——德布西的和声经常在非功能和弦上停留，歌手必须在没有调性支撑的情况下保持准确。力度几乎全程在 p 以下。最大的挑战是在极轻的声音中保持声带的正常振动和腔体共鸣——如果失去支撑就会变成虚声。法语咬字要极其柔和——辅音不能打断旋律的流动。",
  "classroom": [
   "先读中文——理解诗的三层：自然景象→声音细节→灵魂的认同。",
   "用极轻的声音朗读法语——像是在对枕边人耳语。",
   "听一遍钢琴伴奏——感受和声的漂浮感，不要试图找到「落点」。",
   "在钢琴上找到声乐入音——德布西经常让声乐在非和弦音上进入，需要准确的音准。",
   "半速哼唱旋律——保持极窄的音量范围，从 pp 到 p。",
   "加入歌词——法语的连读和省音在慢速下要格外注意。",
   "原速演唱。不要试图「表达」——让音乐自己流动。印象派的目标不是情感表达，而是创造一种氛围。"
  ]
 },
 "hints": [
  {
   "title": "法语半元音与连读",
   "items": [
    "extase [ɛkstaz]——x 发 [ks]，注意不要吞掉",
    "langoureuse 的 ou [u] 和 eu [øz]——两个圆唇元音连续出现",
    "frissons [fʁisɔ̃]——ss 是清 [s]，on 是鼻化 [ɔ̃]",
    "gazouille [gazuj]——ouille 读 [uj]，不是 [wij]"
   ]
  },
  {
   "title": "印象派演唱风格",
   "items": [
    "德布西的歌曲不追求意大利式的共鸣——声音应该像水彩画，边界模糊",
    "许多乐句在极弱的力度上——但不能失去音准和支撑",
    "词与词之间的连接要像水流——没有硬边界"
   ]
  }
 ],
