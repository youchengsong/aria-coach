 "lyrics": [
  {
   "text": "Che faro senza Euridice?",
   "zh": "没有尤里狄切我该怎么办？"
  },
  {
   "text": "Dove andro senza il mio ben?",
   "zh": "没有我的爱人我该去哪里？"
  },
  {
   "text": "Euridice! Euridice!",
   "zh": "尤里狄切！尤里狄切！"
  },
  {
   "text": "Oh Dio! Rispondi! Rispondi!",
   "zh": "天啊！回答我！回答我！"
  },
  {
   "text": "Io son pure il tuo fedele!",
   "zh": "我始终是你的忠实爱人！"
  },
  {
   "text": "Che faro senza Euridice?",
   "zh": "没有尤里狄切我该怎么办？"
